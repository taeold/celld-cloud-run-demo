{
  "name": "celld-workflow-demo",
  "main": "index.js",
  "compatibility_date": "2026-08-18",
  "workflows": [
    {
      "binding": "PIPELINE",
      "name": "demo-workflow",
      "class_name": "DemoWorkflow"
    },
    {
      "binding": "DATA_PIPELINE",
      "name": "data-pipeline",
      "class_name": "DemoWorkflow"
    }
  ]
}
