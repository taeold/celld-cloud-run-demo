{
  "name": "celld-workflow-demo",
  "main": "index.js",
  "compatibility_date": "2026-08-18",
  "workflows": [
    {
      "binding": "PIPELINE",
      "name": "user-onboarding",
      "class_name": "UserOnboardingWorkflow"
    },
    {
